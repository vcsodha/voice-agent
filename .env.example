# Copy this file to a new file named exactly  .env  and put your real key in it.
# Get a key at https://console.anthropic.com  (keep it private, never commit .env)
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# optional
# CLAUDE_MODEL=claude-haiku-5-5
# WHISPER_MODEL_SIZE=base.en

# if it cuts itself off or hears room noise as speech, try a higher number (0 to 3)
# VAD_AGGRESSIVENESS=3

# only for a public link (all off when empty or 0). see "Put it online" in the README
# ACCESS_CODE=pick-a-long-random-phrase
# MAX_TURNS_PER_SESSION=15
# MAX_TURNS_PER_DAY=40
# MAX_CONNECTIONS=2
# LOG_TRANSCRIPTS=0
